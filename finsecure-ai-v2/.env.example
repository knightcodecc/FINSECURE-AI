# LLM configuration (chat_agent.py & xai_engine.py)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Drift monitor
DRIFT_CHECK_INTERVAL_HOURS=24
DRIFT_PSI_THRESHOLD=0.2

# Threshold manager
DEFAULT_THRESHOLD_STRATEGY=cost_optimal   # or f2_optimal

# Alert webhook (carried over from v1)
ALERT_WEBHOOK_URL=

# Auth & Security
SECRET_KEY=change-this-in-production-to-a-secure-random-key
ADMIN_EMAIL=admin@finsecure.ai
ADMIN_PASSWORD=AdminSecure2026!
PORT=8001
